{
  "info": {
    "name": "Bite Buddy - Recipe Sharing API",
    "description": "Comprehensive Postman collection for Bite Buddy Recipe Sharing Platform & REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "System Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"chef_gordon\",\n  \"email\": \"gordon@bitebuddy.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.environment.set(\"jwt_token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"chef_mehul\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "Get All Recipes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes"]
            }
          }
        },
        {
          "name": "Get Trending Recipes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/trending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes", "trending"]
            }
          }
        },
        {
          "name": "Get Recipe by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes", "1"]
            }
          }
        },
        {
          "name": "Search Recipes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/search?q=pasta",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes", "search"],
              "query": [{ "key": "q", "value": "pasta" }]
            }
          }
        },
        {
          "name": "Filter by Category Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/category/italian",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes", "category", "italian"]
            }
          }
        },
        {
          "name": "Get My Recipes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes", "my"]
            }
          }
        },
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Authentic Neapolitan Margherita Pizza\",\n  \"categoryId\": 1,\n  \"description\": \"Crispy airy crust topped with San Marzano tomatoes, fresh buffalo mozzarella, and aromatic basil.\",\n  \"prepTime\": 20,\n  \"cookTime\": 10,\n  \"servings\": 3,\n  \"difficulty\": \"MEDIUM\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=1200&q=80\",\n  \"ingredients\": \"• 300g 00 Flour\\n• 200ml Water\\n• 5g Yeast\\n• San Marzano Tomato Sauce\\n• Fresh Buffalo Mozzarella\\n• Fresh Basil Leaves\",\n  \"instructions\": \"1. Ferment pizza dough for 24 hours.\\n2. Stretch into circular round crust.\\n3. Spread tomato sauce and add mozzarella.\\n4. Bake at maximum oven heat for 8-10 mins.\\n5. Garnish with basil and olive oil.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/recipes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes"]
            }
          }
        },
        {
          "name": "Like Recipe",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/1/like",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes", "1", "like"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Get Public Chef Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/chef_mehul",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "chef_mehul"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://bitebuddy-production.up.railway.app"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ]
}
